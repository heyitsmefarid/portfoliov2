# Copy this file to `.env.local` for local development, and add the same
# variables in your host's dashboard (Vercel → Project → Settings → Environment
# Variables) for production. None of these are sent to the browser — only
# variables prefixed with VITE_ are, and this project uses none.

# ── Visit counter (/api/views) ───────────────────────────────────────────────
# Optional. Added for you when you connect Upstash for Redis in Vercel → Storage.
# Without them the hero simply doesn't show a visit count.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── GitHub contributions (/api/github) ───────────────────────────────────────
# Optional. Without it, a public no-key contributions API is used.
GITHUB_TOKEN=

# ── Contact form (/api/contact) via Resend ───────────────────────────────────
# Optional. Without these the form opens the visitor's email app instead
# (only if you set an email in src/data/profile.js).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
